% Candidate local-arc oracle case-09: X=-5, Y=0 m/s.
Mars.Mu = 42828.375214000000;
Create CoordinateSystem LocalICRF;
LocalICRF.Origin = Mars;
LocalICRF.Axes = ICRF;
Create CoordinateSystem LocalMJ2000;
LocalMJ2000.Origin = Mars;
LocalMJ2000.Axes = MJ2000Eq;
Create Spacecraft BurnReference;
Create ChemicalTank Tank;
Tank.AllowNegativeFuelMass = false;
Tank.FuelMass = 0.25000000000000000;
Create Spacecraft Probe;
Probe.DateFormat = TDBModJulian;
Probe.Epoch = '31617.858318673447';
Probe.CoordinateSystem = LocalICRF;
Probe.DisplayStateType = Cartesian;
Probe.X = 440153.29982437415;
Probe.Y = -37808.394132962712;
Probe.Z = -68263.517218217952;
Probe.VX = -3.0091832714976299;
Probe.VY = 0.30687738020424615;
Probe.VZ = 0.48864582950475310;
Probe.DryMass = 54.114999999999995;
Probe.Tanks = {Tank};
Create ImpulsiveBurn Correction;
Correction.CoordinateSystem = LocalMJ2000;
Correction.DecrementMass = true;
Correction.Tank = {Tank};
Correction.Isp = 230.00000000000000;
Correction.GravitationalAccel = 9.8066499999999994;
Create ForceModel Gravity;
Gravity.CentralBody = Mars;
Gravity.PrimaryBodies = {};
Gravity.PointMasses = {Mars};
Gravity.Drag = None;
Gravity.SRP = Off;
Gravity.RelativisticCorrection = Off;
Create Propagator Prop;
Prop.FM = Gravity;
Prop.Type = PrinceDormand78;
Prop.InitialStepSize = 10;
Prop.Accuracy = 1e-12;
Prop.MinStep = 0.000001;
Prop.MaxStep = 60;
Prop.MaxStepAttempts = 100;
Prop.StopIfAccuracyIsViolated = true;
Create ReportFile States;
States.Filename = 'states.csv';
States.Precision = 17;
States.WriteHeaders = false;
States.FixedWidth = false;
States.Delimiter = ',';
States.WriteReport = true;
BeginMissionSequence;
Report States Probe.ElapsedSecs Probe.TDBModJulian Probe.LocalICRF.X Probe.LocalICRF.Y Probe.LocalICRF.Z Probe.LocalICRF.VX Probe.LocalICRF.VY Probe.LocalICRF.VZ Probe.Tank.FuelMass Probe.TotalMass;
Propagate Prop(Probe) {Probe.ElapsedSecs = 3599};
Report States Probe.ElapsedSecs Probe.TDBModJulian Probe.LocalICRF.X Probe.LocalICRF.Y Probe.LocalICRF.Z Probe.LocalICRF.VX Probe.LocalICRF.VY Probe.LocalICRF.VZ Probe.Tank.FuelMass Probe.TotalMass;
Propagate Prop(Probe) {Probe.ElapsedSecs = 1};
Report States Probe.ElapsedSecs Probe.TDBModJulian Probe.LocalICRF.X Probe.LocalICRF.Y Probe.LocalICRF.Z Probe.LocalICRF.VX Probe.LocalICRF.VY Probe.LocalICRF.VZ Probe.Tank.FuelMass Probe.TotalMass;
BurnReference = Probe;
BurnReference.LocalICRF.VX = Probe.LocalICRF.VX + -0.00078106468714032754;
BurnReference.LocalICRF.VY = Probe.LocalICRF.VY + -0.0045310728159448340;
BurnReference.LocalICRF.VZ = Probe.LocalICRF.VZ + -0.0019645144670142143;
Correction.Element1 = BurnReference.LocalMJ2000.VX - Probe.LocalMJ2000.VX;
Correction.Element2 = BurnReference.LocalMJ2000.VY - Probe.LocalMJ2000.VY;
Correction.Element3 = BurnReference.LocalMJ2000.VZ - Probe.LocalMJ2000.VZ;
Maneuver Correction(Probe);
Report States Probe.ElapsedSecs Probe.TDBModJulian Probe.LocalICRF.X Probe.LocalICRF.Y Probe.LocalICRF.Z Probe.LocalICRF.VX Probe.LocalICRF.VY Probe.LocalICRF.VZ Probe.Tank.FuelMass Probe.TotalMass;
Propagate Prop(Probe) {Probe.ElapsedSecs = 1};
Report States Probe.ElapsedSecs Probe.TDBModJulian Probe.LocalICRF.X Probe.LocalICRF.Y Probe.LocalICRF.Z Probe.LocalICRF.VX Probe.LocalICRF.VY Probe.LocalICRF.VZ Probe.Tank.FuelMass Probe.TotalMass;
Propagate Prop(Probe) {Probe.Mars.Periapsis, StopTolerance = 1e-10};
Report States Probe.ElapsedSecs Probe.TDBModJulian Probe.LocalICRF.X Probe.LocalICRF.Y Probe.LocalICRF.Z Probe.LocalICRF.VX Probe.LocalICRF.VY Probe.LocalICRF.VZ Probe.Tank.FuelMass Probe.TotalMass;
Propagate Prop(Probe) {Probe.Mars.RMAG = 100000, StopTolerance = 1e-7};
Report States Probe.ElapsedSecs Probe.TDBModJulian Probe.LocalICRF.X Probe.LocalICRF.Y Probe.LocalICRF.Z Probe.LocalICRF.VX Probe.LocalICRF.VY Probe.LocalICRF.VZ Probe.Tank.FuelMass Probe.TotalMass;
Propagate Prop(Probe) {Probe.Mars.RMAG = 577000, StopTolerance = 1e-7};
Report States Probe.ElapsedSecs Probe.TDBModJulian Probe.LocalICRF.X Probe.LocalICRF.Y Probe.LocalICRF.Z Probe.LocalICRF.VX Probe.LocalICRF.VY Probe.LocalICRF.VZ Probe.Tank.FuelMass Probe.TotalMass;
