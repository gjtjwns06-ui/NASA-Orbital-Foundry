% Actual-epoch TDB/ICRF adapter probe; central Mars gravity only.
Mars.Mu = 42828.375214000000;
Create CoordinateSystem ProbeMarsICRF;
ProbeMarsICRF.Origin = Mars;
ProbeMarsICRF.Axes = ICRF;
Create Spacecraft Probe;
Probe.DateFormat = TDBModJulian;
Probe.Epoch = '31617.366658694111';
Probe.CoordinateSystem = ProbeMarsICRF;
Probe.DisplayStateType = Cartesian;
Probe.X = 567821.67242352990;
Probe.Y = -50830.423603011470;
Probe.Z = -88996.004960551028;
Probe.VX = -3.0022405329835578;
Probe.VY = 0.30626844815325949;
Probe.VZ = 0.48756337957273010;
Create ForceModel Gravity;
Gravity.CentralBody = Mars;
Gravity.PrimaryBodies = {};
Gravity.PointMasses = {Mars};
Gravity.Drag = None;
Gravity.SRP = Off;
Gravity.RelativisticCorrection = Off;
Create Propagator Prop;
Prop.FM = Gravity;
Prop.Type = PrinceDormand78;
Prop.InitialStepSize = 10;
Prop.Accuracy = 1e-12;
Prop.MinStep = 0.000001;
Prop.MaxStep = 60;
Prop.MaxStepAttempts = 100;
Prop.StopIfAccuracyIsViolated = true;
Create ReportFile States;
States.Filename = 'states.csv';
States.Precision = 17;
States.WriteHeaders = false;
States.FixedWidth = false;
States.Delimiter = ',';
States.WriteReport = true;
BeginMissionSequence;
Report States Probe.ElapsedSecs Probe.TDBModJulian Probe.ProbeMarsICRF.X Probe.ProbeMarsICRF.Y Probe.ProbeMarsICRF.Z Probe.ProbeMarsICRF.VX Probe.ProbeMarsICRF.VY Probe.ProbeMarsICRF.VZ;
Propagate Prop(Probe) {Probe.ElapsedSecs = 60};
Report States Probe.ElapsedSecs Probe.TDBModJulian Probe.ProbeMarsICRF.X Probe.ProbeMarsICRF.Y Probe.ProbeMarsICRF.Z Probe.ProbeMarsICRF.VX Probe.ProbeMarsICRF.VY Probe.ProbeMarsICRF.VZ;
Propagate Prop(Probe) {Probe.ElapsedSecs = 60};
Report States Probe.ElapsedSecs Probe.TDBModJulian Probe.ProbeMarsICRF.X Probe.ProbeMarsICRF.Y Probe.ProbeMarsICRF.Z Probe.ProbeMarsICRF.VX Probe.ProbeMarsICRF.VY Probe.ProbeMarsICRF.VZ;
Propagate Prop(Probe) {Probe.ElapsedSecs = 60};
Report States Probe.ElapsedSecs Probe.TDBModJulian Probe.ProbeMarsICRF.X Probe.ProbeMarsICRF.Y Probe.ProbeMarsICRF.Z Probe.ProbeMarsICRF.VX Probe.ProbeMarsICRF.VY Probe.ProbeMarsICRF.VZ;
Propagate Prop(Probe) {Probe.ElapsedSecs = 60};
Report States Probe.ElapsedSecs Probe.TDBModJulian Probe.ProbeMarsICRF.X Probe.ProbeMarsICRF.Y Probe.ProbeMarsICRF.Z Probe.ProbeMarsICRF.VX Probe.ProbeMarsICRF.VY Probe.ProbeMarsICRF.VZ;
Propagate Prop(Probe) {Probe.ElapsedSecs = 60};
Report States Probe.ElapsedSecs Probe.TDBModJulian Probe.ProbeMarsICRF.X Probe.ProbeMarsICRF.Y Probe.ProbeMarsICRF.Z Probe.ProbeMarsICRF.VX Probe.ProbeMarsICRF.VY Probe.ProbeMarsICRF.VZ;
Propagate Prop(Probe) {Probe.ElapsedSecs = 60};
Report States Probe.ElapsedSecs Probe.TDBModJulian Probe.ProbeMarsICRF.X Probe.ProbeMarsICRF.Y Probe.ProbeMarsICRF.Z Probe.ProbeMarsICRF.VX Probe.ProbeMarsICRF.VY Probe.ProbeMarsICRF.VZ;
Propagate Prop(Probe) {Probe.ElapsedSecs = 60};
Report States Probe.ElapsedSecs Probe.TDBModJulian Probe.ProbeMarsICRF.X Probe.ProbeMarsICRF.Y Probe.ProbeMarsICRF.Z Probe.ProbeMarsICRF.VX Probe.ProbeMarsICRF.VY Probe.ProbeMarsICRF.VZ;
Propagate Prop(Probe) {Probe.ElapsedSecs = 60};
