% Isolated central-gravity research cross-check; not a continuous Earth-Mars mission.
Mars.Mu = 42828.375214000000;
Create CoordinateSystem PrototypeMarsFrame;
PrototypeMarsFrame.Origin = Mars;
PrototypeMarsFrame.Axes = MJ2000Eq;
Create Spacecraft Probe;
Probe.DateFormat = TAIGregorian;
Probe.Epoch = '15 Nov 2026 00:00:00.000';
Probe.CoordinateSystem = PrototypeMarsFrame;
Probe.DisplayStateType = Cartesian;
Probe.X = 567596.62932899874;
Probe.Y = -49747.255901810080;
Probe.Z = -91039.974212395697;
Probe.VX = -3.0286397408990147;
Probe.VY = 0.30306051051929189;
Probe.VZ = 0.50286861600734922;
Create ForceModel Gravity;
Gravity.CentralBody = Mars;
Gravity.PrimaryBodies = {};
Gravity.PointMasses = {Mars};
Gravity.Drag = None;
Gravity.SRP = Off;
Gravity.RelativisticCorrection = Off;
Create Propagator Prop;
Prop.FM = Gravity;
Prop.Type = PrinceDormand78;
Prop.InitialStepSize = 30;
Prop.Accuracy = 1e-12;
Prop.MinStep = 0.000001;
Prop.MaxStep = 60;
Prop.MaxStepAttempts = 100;
Prop.StopIfAccuracyIsViolated = true;
Create ReportFile States;
States.Filename = 'mars-actual-asymptote.csv';
States.Precision = 17;
States.WriteHeaders = false;
States.FixedWidth = false;
States.Delimiter = ',';
States.WriteReport = true;
BeginMissionSequence;
Report States Probe.ElapsedSecs Probe.PrototypeMarsFrame.X Probe.PrototypeMarsFrame.Y Probe.PrototypeMarsFrame.Z Probe.PrototypeMarsFrame.VX Probe.PrototypeMarsFrame.VY Probe.PrototypeMarsFrame.VZ;
Propagate Prop(Probe) {Probe.ElapsedSecs = 300.00000000000000};
