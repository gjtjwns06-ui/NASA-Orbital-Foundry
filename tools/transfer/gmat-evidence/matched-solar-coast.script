% Isolated central-gravity research cross-check; not a continuous Earth-Mars mission.
Sun.Mu = 132712440041.27942;
Create CoordinateSystem PrototypeSunFrame;
PrototypeSunFrame.Origin = Sun;
PrototypeSunFrame.Axes = MJ2000Eq;
Create Spacecraft Probe;
Probe.DateFormat = TAIGregorian;
Probe.Epoch = '15 Nov 2026 00:00:00.000';
Probe.CoordinateSystem = PrototypeSunFrame;
Probe.DisplayStateType = Cartesian;
Probe.X = 84084225.980970383;
Probe.Y = 112042116.51792534;
Probe.Z = 48769678.955929041;
Probe.VX = -26.392228119879331;
Probe.VY = 18.004818279307049;
Probe.VZ = 8.5543448521816767;
Create ForceModel Gravity;
Gravity.CentralBody = Sun;
Gravity.PrimaryBodies = {};
Gravity.PointMasses = {Sun};
Gravity.Drag = None;
Gravity.SRP = Off;
Gravity.RelativisticCorrection = Off;
Create Propagator Prop;
Prop.FM = Gravity;
Prop.Type = PrinceDormand78;
Prop.InitialStepSize = 30;
Prop.Accuracy = 1e-12;
Prop.MinStep = 0.000001;
Prop.MaxStep = 3600;
Prop.MaxStepAttempts = 100;
Prop.StopIfAccuracyIsViolated = true;
Create ReportFile States;
States.Filename = 'matched-solar-coast.csv';
States.Precision = 17;
States.WriteHeaders = false;
States.FixedWidth = false;
States.Delimiter = ',';
States.WriteReport = true;
BeginMissionSequence;
Report States Probe.ElapsedSecs Probe.PrototypeSunFrame.X Probe.PrototypeSunFrame.Y Probe.PrototypeSunFrame.Z Probe.PrototypeSunFrame.VX Probe.PrototypeSunFrame.VY Probe.PrototypeSunFrame.VZ;
Propagate Prop(Probe) {Probe.ElapsedSecs = 86400.000000000000};
