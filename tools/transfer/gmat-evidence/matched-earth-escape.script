% Isolated central-gravity research cross-check; not a continuous Earth-Mars mission.
Earth.Mu = 398600.43550700002;
Create CoordinateSystem PrototypeEarthFrame;
PrototypeEarthFrame.Origin = Earth;
PrototypeEarthFrame.Axes = MJ2000Eq;
Create Spacecraft Probe;
Probe.DateFormat = TAIGregorian;
Probe.Epoch = '15 Nov 2026 00:00:00.000';
Probe.CoordinateSystem = PrototypeEarthFrame;
Probe.DisplayStateType = Cartesian;
Probe.X = -817.58849766273840;
Probe.Y = -5539.8143620138135;
Probe.Z = -3638.6150763283699;
Probe.VX = -11.283644553602658;
Probe.VY = 0.61453855021006942;
Probe.VZ = 1.5997703494784654;
Create ForceModel Gravity;
Gravity.CentralBody = Earth;
Gravity.PrimaryBodies = {};
Gravity.PointMasses = {Earth};
Gravity.Drag = None;
Gravity.SRP = Off;
Gravity.RelativisticCorrection = Off;
Create Propagator Prop;
Prop.FM = Gravity;
Prop.Type = PrinceDormand78;
Prop.InitialStepSize = 30;
Prop.Accuracy = 1e-12;
Prop.MinStep = 0.000001;
Prop.MaxStep = 60;
Prop.MaxStepAttempts = 100;
Prop.StopIfAccuracyIsViolated = true;
Create ReportFile States;
States.Filename = 'matched-earth-escape.csv';
States.Precision = 17;
States.WriteHeaders = false;
States.FixedWidth = false;
States.Delimiter = ',';
States.WriteReport = true;
BeginMissionSequence;
Report States Probe.ElapsedSecs Probe.PrototypeEarthFrame.X Probe.PrototypeEarthFrame.Y Probe.PrototypeEarthFrame.Z Probe.PrototypeEarthFrame.VX Probe.PrototypeEarthFrame.VY Probe.PrototypeEarthFrame.VZ;
Propagate Prop(Probe) {Probe.ElapsedSecs = 300.00000000000000};
Report States Probe.ElapsedSecs Probe.PrototypeEarthFrame.X Probe.PrototypeEarthFrame.Y Probe.PrototypeEarthFrame.Z Probe.PrototypeEarthFrame.VX Probe.PrototypeEarthFrame.VY Probe.PrototypeEarthFrame.VZ;
Propagate Prop(Probe) {Probe.ElapsedSecs = 300.00000000000000};
