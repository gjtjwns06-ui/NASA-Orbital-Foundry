% Independent NAV01 oracle: Keplerian initial elements, analytic RTN, point-mass gravity.
Earth.Mu = 398600.44179999997;
Earth.EquatorialRadius = 6378.1369999999997;
Create Spacecraft Probe;
Probe.DateFormat = TAIGregorian;
Probe.Epoch = '15 Nov 2026 00:00:00.000';
Probe.CoordinateSystem = EarthMJ2000Eq;
