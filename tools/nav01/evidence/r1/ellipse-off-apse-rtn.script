PointMass.CentralBody = Earth;
PointMass.PrimaryBodies = {};
PointMass.PointMasses = {Earth};
PointMass.Drag = None;
PointMass.SRP = Off;
PointMass.RelativisticCorrection = Off;
Create Propagator Prop;
Prop.FM = PointMass;
Prop.Type = PrinceDormand78;
Prop.InitialStepSize = 10;
Prop.Accuracy = 1e-12;
Prop.MinStep = 0.000001;
Prop.MaxStep = 60;
Prop.MaxStepAttempts = 100;
Prop.StopIfAccuracyIsViolated = true;
